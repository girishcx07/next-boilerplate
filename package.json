    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "commitizen": "^4.3.0",
    "cross-env": "^10.1.0",
    "cssnano": "^9.0.2",
    "dotenv": "^17.4.2",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-mdx": "^3.1.5",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "http-server": "^14.1.1",
    "husky": "^9.0.11",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-fail-on-console": "^3.2.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "prettier": "^3.2.5",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "start-server-and-test": "^3.0.12",
    "storybook": "^10.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.9.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
