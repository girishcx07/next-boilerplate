{
  "name": "next16-boilerplate-with-better-auth",
  "description": "Boilerplate and starter for Next.js 16 with App Router, React 19, Better Auth, tRPC, Tailwind CSS 4, and TypeScript.",
  "version": "1.0.0",
  "author": {
    "name": "Paalamugan",
    "url": "https://github.com/paalamugan"
  },
  "scripts": {
    "dev:next": "next dev",
    "dev": "run-p dev:*",
    "build:prod": "next build",
    "build": "npm run build:prod",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "rimraf .next .swc out coverage",
    "deploy": "cross-env NEXT_PUBLIC_STATIC_EXPORT=true npm run build",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\" --cache --cache-strategy=content --cache-location=.eslintjscache --max-warnings 0",
    "lint:md": "eslint \"**/*.md?(x)\" --cache --cache-strategy=content --cache-location=.eslintmdcache --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache --cache-strategy=content --cache-location=.stylelintcache --max-warnings 0",
    "lint": "run-s lint:*",
    "lint:fix:js": "npm run lint:js -- --fix",
    "lint:fix:md": "npm run lint:md -- --fix",
    "lint:fix:css": "npm run lint:css -- --fix",
    "lint:fix": "run-p lint:fix:*",
    "validate": "run-p type-check lint",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,md,mdx,json,yml,css}\" --check --cache --cache-strategy=content --cache-location=.prettiercache",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run lint:fix && npm run prettier:fix",
    "type-check": "tsc --noEmit --pretty",
    "test:unit": "jest",
    "test:watch": "npm run test -- --watch",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "npm run test:e2e -- --ui",
    "storybook:open": "storybook dev -p 6006",
    "storybook": "npm run storybook:open -- --quiet --no-open",
    "storybook:build": "storybook build --quiet --webpack-stats-json",
    "storybook:serve": "http-server storybook-static --port 6006 --silent",
    "serve-storybook": "run-s storybook:build storybook:serve",
    "test-storybook:ci": "start-server-and-test serve-storybook http://127.0.0.1:6006 test-storybook",
    "prepare": "husky",
    "postinstall": "next telemetry disable",
    "commit": "cz"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@heroicons/react": "^2.1.3",
    "@hookform/resolvers": "^3.3.4",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@trpc/client": "11.0.0-rc.370",
    "@trpc/next": "11.0.0-rc.370",
    "@trpc/react-query": "11.0.0-rc.370",
    "@trpc/server": "11.0.0-rc.370",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "glob": "^13.0.6",
    "lucide-react": "^1.39.0",
    "luxon": "^3.7.2",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "path-to-regexp": "^6.2.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.1",
    "sharp": "^0.33.3",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@next/bundle-analyzer": "16.3.4",
    "@next/env": "^16.3.4",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "commitizen": "^4.3.0",
    "cross-env": "^10.1.0",
    "cssnano": "^9.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "http-server": "^14.1.1",
    "husky": "^9.0.11",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-fail-on-console": "^3.2.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "start-server-and-test": "^3.0.12",
    "storybook": "^10.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.9.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/paalamugan/next14-boilerplate-with-next-auth"
  },
  "homepage": "https://github.com/paalamugan/next14-boilerplate-with-next-auth"
}
